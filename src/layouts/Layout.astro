---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "עמותת לנצח אחים",
  description = "עמותת לנצח אחים — נולדה מתוך כאב עמוק במטרה להצמיח תקווה וחיים, מלווה אלמנות, יתומי צה\"ל ולוחמים.",
} = Astro.props;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700&family=Heebo:wght@400;500&family=Noto+Sans+Hebrew:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
