---
import Button from "./Button.astro";
---

<section class="cta" id="join">
  <div class="cta__inner">
    <div class="cta__card">
      <div class="cta__content">
        <div class="cta__text">
          <h2 class="cta__title">בואו להיות חלק</h2>
          <p class="cta__subtitle">
            בכל תרומה שלך,<br />
            אתה מדליק אור בלב של אחר.
          </p>
        </div>
        <Button label="הצטרפו אלינו" variant="outline" icon="heart" href="#contact" />
      </div>
    </div>
    <hr class="cta__rule" />
  </div>
</section>

<style>
  .cta {
    width: 100%;
    background: var(--color-surface-muted);
    padding-block: var(--space-8) var(--space-7);
    padding-inline: var(--layout-gutter);
  }

  .cta__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .cta__card {
    position: relative;
    min-height: 335px;
    border-radius: var(--radius-card);
    background: var(--color-brand) url("/assets/cta-bg.png") center / cover
      no-repeat;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: var(--space-5);
    overflow: clip;
  }

  /* flex-start = RIGHT edge under RTL — title, subtitle & button all
     hug the right edge (button was drifting left before) */
  .cta__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    max-width: 670px;
    text-align: right;
  }

  .cta__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .cta__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-xl);
    color: var(--color-text);
  }

  .cta__subtitle {
    font-family: var(--font-body);
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-md);
    line-height: var(--line-height-body);
    color: var(--color-text-inverse);
  }

  .cta__rule {
    width: 100%;
    height: 1px;
    border: none;
    background: var(--color-brand);
    opacity: 0.4;
    margin: 0;
  }

  @media (max-width: 768px) {
    .cta {
      padding-block: 64px 40px;
      padding-inline: 24px;
    }

    .cta__title {
      font-size: 40px;
      line-height: 1.15;
    }
  }
</style>
