---
import Button from "./Button.astro";
import { useTranslations } from "../i18n/ui";

const t = useTranslations(Astro.currentLocale);

// Nedarim Plus donation page, opened with "standing order" (הוראת קבע) preselected and
// scrolled straight to the payment-type section (#PaiementType)
const MONTHLY_URL = "https://www.matara.pro/nedarimplus/online/?mosad=7019349&KevaDefault=1#PaiementType";
---

<section class="cta" id="join">
  <div class="cta__inner">
    <div class="cta__card">
      <div class="cta__content">
        <div class="cta__text">
          <h2 class="cta__title">{t("cta.title")}</h2>
          <p class="cta__subtitle">
            {t("cta.subtitle1")}<br />
            {t("cta.subtitle2")}
          </p>
        </div>
        <div class="cta__buttons">
        <Button
          label={t("cta.monthly.button")}
          variant="outline"
          icon="heart"
          href={MONTHLY_URL}
          target="_blank"
        />
        <Button
          label={t("cta.once.button")}
          variant="outline"
          icon="heart"
          href="https://pay.hyp.co.il/cgi-bin/yaadpay/yaadpay3ds.pl?Coin=1&FixTash=False&Info=%FA%F8%E5%EE%E4%20%EC%F2%EE%E5%FA%FA%20%26%2334%3B%EC%F0%F6%E7%20%E0%E7%E9%ED%26%2334%3B&Masof=4502127630&MoreData=True&PageLang=HEB&Postpone=False&ShowEngTashText=True&Tash=1&UTF8out=True&action=pay&freq=1&sendemail=True&tmp=1&signature=6ab2c90e28e782859006f72d8f11a07467e030be0b6018db4ee83fed27e543a2"
          target="_blank"
        />
        </div>
      </div>
    </div>
    <hr class="cta__rule" />
  </div>
</section>

<style>
  .cta {
    width: 100%;
    background: var(--color-surface-muted);
    padding-block: var(--space-8) var(--space-7);
    padding-inline: var(--layout-gutter);
  }

  .cta__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .cta__card {
    position: relative;
    min-height: 335px;
    border-radius: var(--radius-card);
    background: var(--color-brand);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: var(--space-5);
    overflow: clip;
  }

  /* decorative swirl art as its own layer so it can mirror for English */
  .cta__card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: url("/assets/cta-bg.png") center / cover no-repeat;
  }

  :global(html[lang="en"]) .cta__card::before {
    transform: scaleX(-1);
  }

  /* flex-start = RIGHT edge under RTL — title, subtitle & button all
     hug the right edge (button was drifting left before) */
  .cta__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    max-width: 670px;
    text-align: start;
  }

  .cta__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  /* standing order + one-time: identical twins — same width, same frame,
     side by side (stacked on mobile) */
  .cta__buttons {
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    gap: var(--space-4);
  }

  .cta__buttons :global(.btn) {
    justify-content: center;
  }

  /* the frame's peach→black sheen slowly circles the button, both in sync */
  @property --cta-ring-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  .cta__buttons :global(.btn--outline::before) {
    background: conic-gradient(
        from var(--cta-ring-angle),
        var(--color-surface-peach),
        #000 50%,
        var(--color-surface-peach)
      )
      border-box;
    animation: cta-ring-spin 4s linear infinite;
  }

  @keyframes cta-ring-spin {
    to {
      --cta-ring-angle: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta__buttons :global(.btn--outline::before) {
      animation: none;
    }
  }

  .cta__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-xl);
    color: var(--color-text);
  }

  .cta__subtitle {
    font-family: var(--font-body);
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-md);
    line-height: var(--line-height-body);
    color: var(--color-text-inverse);
  }

  .cta__rule {
    width: 100%;
    height: 1px;
    border: none;
    background: var(--color-brand);
    opacity: 0.4;
    margin: 0;
  }

  @media (max-width: 768px) {
    .cta {
      padding-block: 64px 40px;
      padding-inline: 24px;
    }

    .cta__title {
      font-size: 40px;
      line-height: 1.15;
    }

    .cta__buttons {
      grid-auto-flow: row;
      gap: var(--space-3);
    }
  }
</style>
