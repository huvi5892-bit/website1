---
import PhotoCard from "./PhotoCard.astro";
import SectionHeading from "./SectionHeading.astro";
import { useTranslations } from "../i18n/ui";

const t = useTranslations(Astro.currentLocale);

const stats = [
  { number: "1500", label: t("stat.1.label") },
  { number: "5", label: t("stat.2.label") },
  { number: "200", label: t("stat.3.label") },
];
---

<section class="activities" id="activities">
  <div class="activities__inner">
    <SectionHeading title={t("activities.heading")} />

    <div class="activities__grid">
      <PhotoCard
        class="card--food"
        image="/assets/photo-2.png"
        title={t("card.food.title")}
        description={t("card.food.desc")}
      />

      <div class="activities__col">
        <div class="activities__row activities__row--top">
          <PhotoCard
            class="card--tefillin"
            image="/assets/photo-3.png"
            title={t("card.tefillin.title")}
            description={t("card.tefillin.desc")}
          />

          <div class="activities__item">
            <PhotoCard
              class="card--widows"
              image="/assets/photo-1.png"
              title={t("card.widows.title")}
              description={t("card.widows.desc")}
            />

            <div class="stats">
              {
                stats.map((stat, i) => (
                  <>
                    {i > 0 && <img class="stats__dot" src="/assets/dot.svg" alt="" />}
                    <div class="stat">
                      <span class="stat__number" data-count={stat.number}>{stat.number}</span>
                      <span class="stat__label">{stat.label}</span>
                    </div>
                  </>
                ))
              }
            </div>
          </div>
        </div>

        <div class="activities__row activities__row--bottom">
          <PhotoCard
            class="card--lonely"
            image="/assets/photo-4.png"
            title={t("card.lonely.title")}
            description={t("card.lonely.desc")}
          />
          <PhotoCard
            class="card--support"
            image="/assets/photo-5.png"
            title={t("card.support.title")}
            description={t("card.support.desc")}
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .activities {
    width: 100%;
    background: var(--color-surface-muted);
    padding-block: var(--space-8);
    padding-inline: var(--layout-gutter);
  }

  .activities__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* Bento grid — forced LTR so the composition matches Figma
     (food card on the left, flowing left→right). Card text stays RTL. */
  .activities__grid {
    display: flex;
    gap: var(--space-5);
    align-items: stretch;
    direction: ltr;
  }

  .activities__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    flex: 1 1 auto;
    min-width: 0;
  }

  .activities__row {
    display: flex;
    gap: var(--space-5);
  }

  .activities__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    flex: 1 1 auto;
    min-width: 0;
  }

  /* Card sizing lives in PhotoCard.astro (scoped-style reasons) */

  /* Stats row */
  .stats {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: nowrap;
  }

  .stats__dot {
    width: 16.5px;
    height: 16.5px;
    flex-shrink: 0;
    margin-top: 24px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 165px;
    direction: rtl;
    /* slides up + fades in when the section scrolls into view */
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .stat.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .stat {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .stat__number {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    line-height: 1;
    color: var(--color-text-brand);
    letter-spacing: var(--letter-spacing-2xl);
  }

  .stat__label {
    font-size: var(--font-size-base);
    line-height: var(--line-height-snug);
    color: var(--color-text);
  }

  @media (max-width: 1100px) {
    .activities__grid,
    .activities__row {
      flex-wrap: wrap;
    }
  }

  @media (max-width: 768px) {
    .activities {
      padding-block: 64px;
      padding-inline: 24px;
    }

    /* keep all three stats on one row without overflowing the screen */
    .stats {
      gap: 8px;
    }

    .stat {
      max-width: none;
      flex: 1 1 0;
      min-width: 0;
    }

    .stat__number {
      font-size: 40px;
    }

    .stat__label {
      font-size: 14px;
      line-height: 1.3;
    }

    .stats__dot {
      width: 11px;
      height: 11px;
      margin-top: 16px;
    }
  }
</style>

<script>
  // Count the stat numbers up from 0 to their target, and slide the stat in,
  // when the row first scrolls into view.
  const stats = document.querySelectorAll<HTMLElement>(".stat");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const frames = new WeakMap<HTMLElement, number>();

  const animateNumber = (el: HTMLElement, target: number) => {
    const prev = frames.get(el);
    if (prev) cancelAnimationFrame(prev); // stop any running count-up first
    const duration = 1500;
    const start = performance.now();
    const step = (now: number) => {
      const p = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - p, 3); // easeOutCubic
      el.textContent = String(Math.round(eased * target));
      if (p < 1) frames.set(el, requestAnimationFrame(step));
      else el.textContent = String(target);
    };
    frames.set(el, requestAnimationFrame(step));
  };

  // seed the display at 0 so the count-up starts from zero
  stats.forEach((stat) => {
    const num = stat.querySelector<HTMLElement>(".stat__number");
    if (num && !reduce) num.textContent = "0";
  });

  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const stat = entry.target as HTMLElement;
        const num = stat.querySelector<HTMLElement>(".stat__number");
        const target = Number(num?.dataset.count ?? 0);

        if (entry.isIntersecting) {
          // re-run the count-up every time the row scrolls back into view
          stat.classList.add("is-visible");
          if (num && !reduce) animateNumber(num, target);
        } else {
          // reset so the next entry animates from zero again
          stat.classList.remove("is-visible");
          if (num && !reduce) num.textContent = "0";
        }
      });
    },
    { threshold: 0.6 }
  );

  stats.forEach((stat) => io.observe(stat));
</script>
