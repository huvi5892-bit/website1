---
import Button from "./Button.astro";
import SectionHeading from "./SectionHeading.astro";
import { useTranslations } from "../i18n/ui";

const t = useTranslations(Astro.currentLocale);

// Vertical video columns. Each column shows a poster frame pulled from its own
// clip; clicking play expands that column sideways and plays the video inline.
const columns = Array.from({ length: 7 }, (_, i) => ({
  video: `/assets/mizmar-${i + 1}.mp4`,
  poster: `/assets/mizmar-${i + 1}.jpg`,
}));
---

<section class="projects" id="projects">
  <div class="projects__inner">
    <SectionHeading title={t("projects.heading")} />

    <div class="projects__row" data-projects>
      {
        columns.map((col, i) => (
          <div class="project" data-project style={`background-image:url(${col.poster})`}>
            <video
              class="project__video"
              src={col.video}
              poster={col.poster}
              preload="none"
              playsinline
              controls
            />
            <button
              class="project__play"
              type="button"
              aria-label={`${t("projects.playLabel")} ${i + 1}`}
            >
              <img src="/assets/play-icon.svg" alt="" />
            </button>
            <button class="project__close" type="button" aria-label={t("projects.closeLabel")}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </button>
          </div>
        ))
      }
    </div>

    <Button label={t("projects.cta")} icon="arrow" href="#join" />
  </div>
</section>

<style>
  .projects {
    width: 100%;
    background: var(--color-surface);
    padding-block: var(--space-8);
    padding-inline: var(--layout-gutter);
  }

  .projects__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-7);
  }

  .projects__row {
    width: 100%;
    display: flex;
    gap: 18px;
    align-items: stretch;
  }

  .project {
    /* equal columns that grow/shrink; the active one expands sideways */
    flex: 1 1 0;
    min-width: 0;
    height: 526px;
    border-radius: var(--radius-full);
    background-size: cover;
    background-position: center;
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-block-end: var(--space-5);
    overflow: clip;
    cursor: pointer;
    transition: flex-grow 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 0.45s ease;
  }

  .project.is-active {
    /* opens wide, others stay recognisable (not razor-thin slivers) */
    flex-grow: 10;
    border-radius: 28px;
    cursor: default;
  }

  .project__video {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    background: #000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .project.is-active .project__video {
    opacity: 1;
    pointer-events: auto;
  }

  .project__play {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 88px;
    height: 88px;
    padding: 13px;
    border: none;
    border-radius: var(--radius-play);
    background: var(--color-surface-peach);
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.2s ease,
      width 0.4s ease, height 0.4s ease, padding 0.4s ease;
  }

  /* when a video is open, the other (now-narrow) columns get a proportionally
     smaller play button so it stays inside the thin pill */
  .projects__row.has-active .project:not(.is-active) .project__play {
    width: 46px;
    height: 46px;
    padding: 8px;
  }

  .projects__row.has-active .project:not(.is-active) .project__play img {
    width: 30px;
    height: 30px;
  }

  .project__play:hover {
    transform: scale(1.06);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
  }

  .project__play img {
    width: 62px;
    height: 62px;
  }

  .project.is-active .project__play {
    opacity: 0;
    pointer-events: none;
  }

  .project__close {
    position: absolute;
    top: 12px;
    inset-inline-end: 12px;
    z-index: 3;
    width: 38px;
    height: 38px;
    display: none;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .project__close:hover {
    background: rgba(0, 0, 0, 0.8);
    transform: scale(1.08);
  }

  .project.is-active .project__close {
    display: flex;
  }

  @media (prefers-reduced-motion: reduce) {
    .project,
    .project__video,
    .project__play,
    .project__close {
      transition: none;
    }
  }

  /* ---- Mobile / tablet: a swipeable horizontal slider ---- */
  @media (max-width: 1000px) {
    .projects__row {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 14px;
      padding-block-end: 10px;
      /* let the slider bleed to the screen edges for a nicer feel */
      scrollbar-width: none;
    }

    .projects__row::-webkit-scrollbar {
      display: none;
    }

    .project {
      flex: 0 0 200px;
      height: 440px;
      scroll-snap-align: center;
    }

    /* no sideways expand inside the slider — the clip just plays in place */
    .project.is-active {
      flex: 0 0 200px;
      border-radius: var(--radius-full);
    }
  }

  @media (max-width: 768px) {
    .projects {
      padding-block: 64px;
      padding-inline: 24px;
    }

    .project {
      flex: 0 0 168px;
      height: 380px;
    }

    .project.is-active {
      flex: 0 0 168px;
    }

    .project__play {
      width: 62px;
      height: 62px;
      padding: 10px;
    }

    .project__play img {
      width: 42px;
      height: 42px;
    }

    /* keep play buttons full size in the slider (no shrink-when-active) */
    .projects__row.has-active .project:not(.is-active) .project__play {
      width: 62px;
      height: 62px;
      padding: 10px;
    }

    .projects__row.has-active .project:not(.is-active) .project__play img {
      width: 42px;
      height: 42px;
    }
  }
</style>

<script>
  const row = document.querySelector<HTMLElement>("[data-projects]");
  if (row) {
    const projects = Array.from(
      row.querySelectorAll<HTMLElement>("[data-project]")
    );

    const videoOf = (p: HTMLElement) =>
      p.querySelector<HTMLVideoElement>(".project__video");

    const activate = (p: HTMLElement) => {
      projects.forEach((other) => {
        if (other !== p) {
          other.classList.remove("is-active");
          const v = videoOf(other);
          if (v) v.pause();
        }
      });
      p.classList.add("is-active");
      row.classList.add("has-active");
      videoOf(p)?.play().catch(() => {});
    };

    const deactivate = (p: HTMLElement) => {
      p.classList.remove("is-active");
      const v = videoOf(p);
      if (v) {
        v.pause();
        v.currentTime = 0;
      }
      if (!row.querySelector(".project.is-active")) {
        row.classList.remove("has-active");
      }
    };

    projects.forEach((p) => {
      p.querySelector(".project__play")?.addEventListener("click", (e) => {
        e.stopPropagation();
        activate(p);
      });
      p.querySelector(".project__close")?.addEventListener("click", (e) => {
        e.stopPropagation();
        deactivate(p);
      });
      // clicking anywhere on a collapsed column also opens it
      p.addEventListener("click", () => {
        if (!p.classList.contains("is-active")) activate(p);
      });
    });
  }
</script>
