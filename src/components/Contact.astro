---
import Button from "./Button.astro";
import SectionHeading from "./SectionHeading.astro";
import { useTranslations } from "../i18n/ui";

const t = useTranslations(Astro.currentLocale);

// Web3Forms — public access keys (safe to expose). The free plan allows one
// recipient per form, so each recipient has their own form/key and every
// submission is sent to all of them. Recipients are set in the Web3Forms
// dashboard, per form.
const ACCESS_KEYS = [
  "bad57d12-fd1f-4b4f-af1b-6b07672658d2", // "Lanetzach Achim Form" → the client
  "f00eb418-2f2a-4b30-9e0f-a70cab9f04d2", // copy form → Huvi5892@gmail.com
];

const messages = {
  sending: t("contact.sending"),
  success: t("contact.success"),
  error: t("contact.error"),
};
---

<section class="contact" id="contact">
  <div class="contact__inner">
    <form
      class="contact__form"
      id="contact-form"
      action="https://api.web3forms.com/submit"
      method="POST"
    >
      <SectionHeading title={t("contact.heading")} />

      {/* no-JS fallback posts to the first form only; the script sends to all */}
      <input type="hidden" name="access_key" value={ACCESS_KEYS[0]} />
      <input type="hidden" name="subject" value="פנייה חדשה מאתר לנצח אחים" />
      <input type="hidden" name="from_name" value="אתר לנצח אחים" />
      {/* honeypot spam trap — real users never fill this */}
      <input
        type="checkbox"
        name="botcheck"
        class="contact__honeypot"
        tabindex="-1"
        autocomplete="off"
      />

      <div class="contact__fields">
        <div class="field">
          <input type="text" name="name" required placeholder={t("contact.name")} aria-label={t("contact.name")} />
        </div>
        <div class="field">
          <input type="tel" name="phone" required placeholder={t("contact.phone")} aria-label={t("contact.phone")} />
        </div>
        <div class="field">
          <input type="email" name="email" placeholder={t("contact.email")} aria-label={t("contact.email")} />
        </div>
      </div>

      <div class="field field--message">
        <textarea
          name="message"
          rows="3"
          placeholder={t("contact.message")}
          aria-label={t("contact.message")}></textarea>
      </div>

      <Button label={t("contact.button")} icon="arrow" type="submit" />

      <p class="contact__status" id="contact-status" role="status" aria-live="polite" hidden></p>
    </form>

    <div class="contact__media">
      <img src="/assets/logo.png" alt={t("hero.logoAlt")} />
    </div>
  </div>
</section>

<script define:vars={{ messages, accessKeys: ACCESS_KEYS }}>
  const form = document.getElementById("contact-form");
  const statusEl = document.getElementById("contact-status");
  const label = form?.querySelector(".btn__label");
  const original = label?.textContent;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    statusEl.hidden = true;
    if (label) label.textContent = messages.sending;

    // one request per recipient form; the visitor sees success if any arrived
    const send = async (key) => {
      const body = new FormData(form);
      body.set("access_key", key);
      const res = await fetch("https://api.web3forms.com/submit", { method: "POST", body });
      const data = await res.json();
      if (!data.success) throw new Error(data.message);
    };

    try {
      const results = await Promise.allSettled(accessKeys.map(send));
      if (results.some((r) => r.status === "fulfilled")) {
        statusEl.textContent = messages.success;
        statusEl.className = "contact__status is-success";
        form.reset();
      } else {
        statusEl.textContent = messages.error;
        statusEl.className = "contact__status is-error";
      }
    } catch {
      statusEl.textContent = messages.error;
      statusEl.className = "contact__status is-error";
    } finally {
      statusEl.hidden = false;
      if (label) label.textContent = original;
    }
  });
</script>

<style>
  .contact {
    width: 100%;
    background: var(--color-surface-muted);
    padding-block-end: var(--space-8);
    padding-inline: var(--layout-gutter);
  }

  .contact__inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .contact__media {
    flex: 0 0 389px;
  }

  .contact__media img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .contact__form {
    flex: 0 0 624px;
    display: flex;
    flex-direction: column;
    /* flex-start = right edge under RTL */
    align-items: flex-start;
    gap: var(--space-5);
  }

  .contact__fields {
    width: 100%;
    display: flex;
    gap: var(--space-5);
    flex-wrap: wrap;
    justify-content: flex-start;
  }

  /* name / phone / email share the row equally and line up with the
     full-width message box below */
  .field {
    flex: 1 1 160px;
    min-width: 0;
    border-bottom: 1px solid var(--color-border-brand);
  }

  /* message box spans the full form width */
  .field--message {
    flex-basis: 100%;
    width: 100%;
  }

  .field input,
  .field textarea {
    width: 100%;
    border: none;
    background: transparent;
    padding: 10px 0;
    font-family: var(--font-form);
    font-size: var(--font-size-base);
    color: var(--color-text);
    /* force RTL so the tel/email placeholder (and its colon) render on the
       right — these input types otherwise default to LTR */
    direction: rtl;
    text-align: right;
  }

  :global(html[lang="en"]) .field input,
  :global(html[lang="en"]) .field textarea {
    direction: ltr;
    text-align: left;
  }

  .field textarea {
    display: block;
    resize: vertical;
    min-height: 46px;
    line-height: var(--line-height-snug);
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--color-text);
    opacity: var(--opacity-placeholder);
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
  }

  /* hidden spam honeypot */
  .contact__honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    width: 0;
    pointer-events: none;
  }

  .contact__status {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    line-height: var(--line-height-snug);
  }

  .contact__status.is-success {
    color: #2e7d32;
  }

  .contact__status.is-error {
    color: #c62828;
  }

  @media (max-width: 900px) {
    .contact__inner {
      flex-direction: column;
      align-items: center;
      gap: var(--space-6);
    }

    .contact__form,
    .contact__media {
      flex: 1 1 100%;
      width: 100%;
    }

    .contact__media {
      max-width: 320px;
    }
  }

  @media (max-width: 768px) {
    .contact {
      padding-block-end: 64px;
      padding-inline: 24px;
    }
  }
</style>
