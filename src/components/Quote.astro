---
import { useTranslations } from "../i18n/ui";

const t = useTranslations(Astro.currentLocale);
---

<section class="quote">
  <div class="quote__inner">
    <p class="quote__text">
      <span>{t("quote.line1")}</span>
      <span>{t("quote.line2")}</span>
      <span>{t("quote.line3a")}<span class="quote__text--dark">{t("quote.line3b")}</span></span>
    </p>
    <img class="quote__signature" src="/assets/signature.png" alt={t("quote.signatureAlt")} />
  </div>

  <!-- teardrop photos — shown only on mobile, stacked below the text -->
  <img class="quote__photos" src="/assets/quote-photos.png" alt="" aria-hidden="true" />

  <!-- gold divider with a diamond at its left end, sitting at the bottom -->
  <div class="quote__divider" aria-hidden="true"></div>
</section>

<style>
  .quote {
    position: relative;
    width: 100%;
    /* lock to the background image's aspect (1440×459) so the teardrop photos
       are always shown in full and END exactly at the section's bottom edge,
       at every screen width — the divider then lands right at the photo tips */
    aspect-ratio: 1440 / 459;
    min-height: 459px;
    display: flex;
    align-items: center;
    background: var(--color-surface-muted) url("/assets/quote-bg.png") center /
      cover no-repeat;
    padding-inline: var(--layout-gutter);
    /* visible so the centred diamond on the bottom divider isn't clipped */
    overflow: visible;
  }

  .quote__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content-max-width);
    margin-inline: auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    /* flex-end = LEFT under RTL — text block sits on the left,
       clear of the teardrop photos baked into quote-bg (right side) */
    align-items: flex-end;
  }

  /* the photos are baked into the background on the right in both languages,
     so keep the English (LTR) text block on the left too */
  :global(html[lang="en"]) .quote__inner {
    align-items: flex-start;
  }

  .quote__text {
    display: block;
    max-width: 620px;
    text-align: start;
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    line-height: var(--line-height-hero);
    letter-spacing: var(--letter-spacing-xl);
    color: var(--color-text-brand);
  }

  .quote__text span {
    display: block;
  }

  .quote__text .quote__text--dark {
    display: inline;
  }

  .quote__text--dark {
    color: var(--color-text);
  }

  .quote__signature {
    width: 134px;
    height: auto;
    margin-top: var(--space-3);
  }

  /* Divider line below the teardrop (bleeds to the right edge) with a
     rotated-square diamond at its left end */
  /* diamond sits 181px left of centre (matches Figma's x539 on the 1440
     canvas) and holds that relationship at any width; line bleeds right */
  .quote__divider {
    position: absolute;
    /* sits exactly at the bottom edge of the teardrop photos */
    bottom: 0;
    left: calc(50% - 181px);
    right: 0;
    /* above the background photos so the line is visible */
    z-index: 2;
    /* Figma: stroke-width 2px, solid gold #C08B2F (no gradient) */
    height: 2px;
    background: var(--color-brand);
  }

  .quote__divider::before {
    content: "";
    position: absolute;
    left: 0;
    /* centred on the line — line passes through its middle, like every other
       diamond end-cap on the site */
    top: 50%;
    /* 7px diamond, same size as the section-heading end-caps */
    width: 7px;
    height: 7px;
    background: var(--color-brand);
    transform: translate(-50%, -50%) rotate(45deg);
  }

  /* teardrop photos only appear on mobile (desktop uses the background image) */
  .quote__photos {
    display: none;
  }

  @media (max-width: 768px) {
    /* stack: text on top, teardrop photos below — no background image */
    .quote {
      aspect-ratio: auto;
      min-height: 0;
      background: var(--color-surface-muted);
      overflow: clip;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 56px 24px;
      gap: 28px;
    }

    .quote__inner {
      align-items: center;
      text-align: center;
    }

    .quote__text {
      text-align: center;
      font-size: 36px;
      line-height: 1.18;
    }

    .quote__signature {
      margin-inline: auto;
    }

    /* full teardrops, large enough that the faces are never cut */
    .quote__photos {
      display: block;
      width: 100%;
      max-width: 420px;
      height: auto;
    }

    .quote__divider {
      display: none;
    }
  }
</style>
